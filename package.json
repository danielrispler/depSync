{
	"name": "depsync",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"start": "node src/index.ts",
		"build": "ncc build src/index.ts -o dist",
		"test": "vitest run",
		"test:unit": "vitest run src/**/__tests__/**/*.test.unit.ts",
		"test:int": "vitest run src/**/__tests__/**/*.test.int.ts",
		"test:watch": "vitest",
		"lint": "biome check src/ --write",
		"format": "biome format --write src/",
		"typecheck": "tsc --noEmit",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.32.0",
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/node": "^25.4.0",
		"@types/semver": "^7.7.1",
		"@vercel/ncc": "^0.38.4",
		"husky": "^9.1.7",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^6.0.0",
		"@actions/glob": "^0.4.0",
		"@google/genai": "^1.45.0",
		"semver": "^7.7.4",
		"ts-morph": "^27.0.2"
	}
